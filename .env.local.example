# EFTA Investigation Platform — Environment Variables
# Copy to .env.local and fill in your values
# NEVER commit .env.local to git

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=efta-documents
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Cloudflare Turnstile (bot prevention on signup/login)
# Get keys from: https://dash.cloudflare.com/?to=/:account/turnstile
# Leave blank to disable Turnstile (auto-bypass in dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry (error monitoring — optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Anthropic (AI assistants)
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
